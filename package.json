		"test": "vitest run",
		"prepack": "npm run build"
	},
	"dependencies": {
		"curt-format": "^1.2.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	},
	"keywords": [
		"curt",
		"openclaw",
		"converter",
		"transcript"
