{
	"name": "curt-openclaw",
	"version": "1.0.0",
	"description": "Convert OpenClaw gateway session transcripts to .curt conversation files",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"bin": {
		"curt-openclaw": "dist/cli.js"
	},
	"main": "dist/openclaw.js",
	"types": "dist/openclaw.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
